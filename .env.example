# URL of the OpenAI-compatible endpoint your running llamafile exposes.
# When llamafile runs on the same machine as `npm run dev`, the default
# port 8080 works out of the box. When this app is deployed to Vercel,
# this must be a URL Vercel's servers can reach over the internet
# (e.g. an ngrok / Cloudflare Tunnel address), not "localhost".
LLAMAFILE_URL=http://localhost:8080/v1/chat/completions

# Only needed if you started llamafile with --api-key.
LLAMAFILE_API_KEY=
